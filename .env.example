# Image fra GitHub Container Registry (bruges med docker-compose.ghcr.yml)
GHCR_IMAGE=ghcr.io/stefan240987/borgerliste-app:latest

# PÅKRÆVET i produktion: stærk admin-adgangskode (min. 12 tegn anbefales)
BORGERLISTE_ADMIN_USERNAME=admin
BORGERLISTE_ADMIN_PASSWORD=skift-mig-til-en-staerk-adgangskode

# I Docker (/data) kræves admin-password ved første start (ingen plaintext bootstrap-fil).
# Sæt false kun til lokal udvikling uden env-password.
# BORGERLISTE_REQUIRE_ADMIN_PASSWORD=true

# Selvbetjent brugeroprettelse — default er slået fra (kan også styres i admin-UI)
BORGERLISTE_PUBLIC_SIGNUP_ENABLED=false

# Session: hvor længe du forbliver logget ind ved inaktivitet (i minutter)
BORGERLISTE_SESSION_IDLE_MINUTES=1440
# Ældre variabel (timer) understøttes stadig som fallback
# BORGERLISTE_SESSION_IDLE_HOURS=24
BORGERLISTE_SESSION_MAX_DAYS=30

# Produktion bag HTTPS reverse proxy (Nginx Proxy Manager, Swag, m.fl.)
BORGERLISTE_COOKIE_SECURE=true
# Sæt kun true når appen kører bag en trusted reverse proxy der sætter X-Forwarded-For
# BORGERLISTE_TRUST_PROXY=true

# Anbefalet i produktion: fast Fernet-nøgle til persondata i hvile (base64).
# Generér fx med: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Hvis tom, oprettes en nøgle automatisk i /data/.encryption_key (skal backupsikres).
# BORGERLISTE_ENCRYPTION_KEY=
